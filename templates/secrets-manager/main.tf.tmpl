# Generated by gh-platform-control IssueOps
# Issue: {{CONTROL_REPO}}#{{ISSUE_NUMBER}}
# Product: secrets-manager
# Do not put secret values in Issues — placeholder version only; populate out-of-band.

terraform {
  required_version = ">= 1.10.0"
  required_providers {
    aws = { source = "hashicorp/aws", version = ">= 5.0" }
  }

  backend "s3" {}
}

provider "aws" {
  region = "{{AWS_REGION}}"
}

module "tags" {
  source = "git::https://github.com/{{MODULES_REPOSITORY}}.git?ref={{TAGGING_MODULE_REF}}"

  environment = "{{TAGGING_ENVIRONMENT}}"
  project     = "{{PROJECT}}"
}

module "secret" {
  source = "git::https://github.com/{{MODULES_REPOSITORY}}.git?ref={{MODULE_REF}}"

  secret_name                    = "{{SECRET_NAME}}"
  description                    = "{{SECRET_DESCRIPTION}}"
  create_placeholder_version     = true
  preserve_existing_secret_values = false
  recovery_window_in_days        = 30

  tags = module.tags.tags
}

output "secret_id" {
  value = module.secret.secret_id
}

output "secret_arn" {
  value = module.secret.secret_arn
}
