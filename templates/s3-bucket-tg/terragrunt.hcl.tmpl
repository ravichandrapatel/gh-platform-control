include "root" {
  path = find_in_parent_folders("root.hcl")
}

terraform {
  source = "git::https://github.com/{{MODULES_REPOSITORY}}.git?ref={{MODULE_REF}}"
}

inputs = {
  bucket_name             = "{{BUCKET_NAME}}"
  enable_versioning       = {{ENABLE_VERSIONING}}
  enable_encryption       = true
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true

  # Thin wrapper: pass tagging fields directly (same keys as tagging module outputs).
  tags = {
    Environment = "{{TAGGING_ENVIRONMENT}}"
    Project     = "{{PROJECT}}"
  }
}
