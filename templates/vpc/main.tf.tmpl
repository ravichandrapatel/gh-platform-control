# Generated by gh-platform-control IssueOps
# Issue: {{CONTROL_REPO}}#{{ISSUE_NUMBER}}
# Product: vpc
# Do not edit by hand unless breaking glass — prefer a follow-up Issue Form.

terraform {
  required_version = ">= 1.10.0"
  required_providers {
    aws = { source = "hashicorp/aws", version = ">= 5.0" }
  }

  backend "s3" {}
}

provider "aws" {
  region = "{{AWS_REGION}}"
}

data "aws_availability_zones" "available" {
  state = "available"
}

locals {
  az0 = data.aws_availability_zones.available.names[0]
  az1 = length(data.aws_availability_zones.available.names) > 1 ? data.aws_availability_zones.available.names[1] : data.aws_availability_zones.available.names[0]
}

module "tags" {
  source = "git::https://github.com/{{MODULES_REPOSITORY}}.git?ref={{TAGGING_MODULE_REF}}"

  environment = "{{TAGGING_ENVIRONMENT}}"
  project     = "{{PROJECT}}"
}

module "vpc" {
  source = "git::https://github.com/{{MODULES_REPOSITORY}}.git?ref={{MODULE_REF}}"

  vpc_name   = "{{VPC_NAME}}"
  cidr_block = "{{CIDR_BLOCK}}"

  public_subnets = [
    {
      cidr_block        = cidrsubnet("{{CIDR_BLOCK}}", 8, 1)
      availability_zone = local.az0
      name              = "public-1"
    },
    {
      cidr_block        = cidrsubnet("{{CIDR_BLOCK}}", 8, 2)
      availability_zone = local.az1
      name              = "public-2"
    }
  ]

  private_subnets = [
    {
      cidr_block        = cidrsubnet("{{CIDR_BLOCK}}", 8, 11)
      availability_zone = local.az0
      name              = "private-1"
    },
    {
      cidr_block        = cidrsubnet("{{CIDR_BLOCK}}", 8, 12)
      availability_zone = local.az1
      name              = "private-2"
    }
  ]

  create_internet_gateway = true
  create_nat_gateway      = {{CREATE_NAT_GATEWAY}}
  nat_gateway_per_az      = false

  tags = module.tags.tags
}

output "vpc_id" {
  value = module.vpc.vpc_id
}

output "public_subnet_ids" {
  value = module.vpc.public_subnet_ids
}

output "private_subnet_ids" {
  value = module.vpc.private_subnet_ids
}
